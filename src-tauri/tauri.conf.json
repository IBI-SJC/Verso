{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Verso",
  "version": "1.1.1",
  "identifier": "com.IBISJC.Verso",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Verso",
        "width": 800,
        "height": 300,
        "alwaysOnTop": true,
        "resizable": false,
        "maximizable": false,
        "x": 720,
        "y": 480,
        "closable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
